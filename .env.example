# Neon PostgreSQL — pooled connection (use for app runtime on Vercel + local dev)
# Get from: Neon Console → Connection Details → "Pooled connection"
# Use sslmode=require and pgbouncer=true. Do NOT add channel_binding=require (breaks on Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon PostgreSQL — direct connection (use for Prisma migrations / db:push)
# Get from: Neon Console → Connection Details → "Direct connection"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional: protect cron endpoint for scheduled publishing
CRON_SECRET="generate-a-random-secret"

# Cloudinary (unsigned upload) — get from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
